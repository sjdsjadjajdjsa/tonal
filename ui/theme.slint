import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

export global Theme {
    in-out property <color> accent: #ececee;
    in-out property <color> background: #141416c8;
    in-out property <color> sidebar: #0000002e;
    in-out property <color> bar: #0000003d;
    in-out property <color> panel: #00000024;
    in-out property <color> surface: #ffffff0b;
    in-out property <color> raised: #ffffff13;
    in-out property <color> hover: #ffffff17;
    in-out property <color> border: #ffffff14;
    in-out property <color> text: #f3f3f5;
    in-out property <color> muted: #a2a2a8;
    in-out property <color> faint: #6e6e74;
    in-out property <color> on-accent: #111113;
    in-out property <color> popup: #1c1c1f;
    in-out property <length> radius-s: 6px;
    in-out property <length> radius-m: 10px;
    in-out property <length> radius-l: 14px;
}

