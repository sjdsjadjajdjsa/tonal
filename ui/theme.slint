export component Label inherits Text {
    color: Theme.text;
    font-family: "Inter";
    font-size: 13px;
    overflow: elide;
    vertical-alignment: center;
}

export component Icon inherits Path {
    in property <string> data;
    in property <color> tint: Theme.text;
    in property <bool> filled;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.data;
    fill: root.filled ? root.tint : transparent;
    stroke: root.filled ? transparent : root.tint;
    stroke-width: root.filled ? 0px : 1.8px;
    stroke-line-cap: round;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> filled;
    in property <length> size: 34px;
    in property <length> icon-size: 18px;
    in property <color> tint: Theme.muted;
    in property <bool> enabled: true;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    opacity: root.enabled ? 1 : 0.35;
    background: touch.pressed ? Theme.raised : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    Icon {
        data: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        filled: root.filled;
        tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : root.tint;
    }
    if root.active: Rectangle {
        y: root.height - 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked;
    height: 34px;
    width: content.preferred-width;
    border-radius: 17px;
    background: root.primary ? (touch.has-hover ? Theme.accent.brighter(0.12) : Theme.accent)
        : root.danger ? (touch.has-hover ? #e5484d : #c6383d)
        : touch.has-hover ? Theme.hover : Theme.surface;
    animate background { duration: 120ms; }
    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                width: 15px;
                height: 15px;
                tint: root.primary ? Theme.on-accent : Theme.text;
            }
        }
        Label {
            text: root.text;
            font-size: 12.5px;
            font-weight: 600;
            color: root.primary ? Theme.on-accent : Theme.text;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Scrubber inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1;
    in property <bool> live;
    in property <length> bar: 4px;
    in property <bool> enabled: true;
    callback changed(float);
    private property <float> drag;
    private property <float> shown: touch.pressed ? root.drag : root.value;
    private property <float> ratio: root.maximum > 0 ? clamp(root.shown / root.maximum, 0, 1) : 0;
    private property <bool> engaged: touch.has-hover || touch.pressed;
    height: 16px;
    opacity: root.enabled ? 1 : 0.35;
    Rectangle {
        y: (root.height - root.bar) / 2;
        height: root.bar;
        border-radius: root.bar / 2;
        background: Theme.border;
    }
    Rectangle {
        x: 0;
        y: (root.height - root.bar) / 2;
        width: root.width * root.ratio;
        height: root.bar;
        border-radius: root.bar / 2;
        background: root.engaged ? Theme.accent : Theme.text;
    }
    if root.engaged: Rectangle {
        x: root.width * root.ratio - 6px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0008;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag = clamp(self.mouse-x / max(1px, self.width), 0, 1) * root.maximum;
                if root.live { root.changed(root.drag); }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.changed(root.drag);
            }
        }
        moved => {
            if self.pressed {
                root.drag = clamp(self.mouse-x / max(1px, self.width), 0, 1) * root.maximum;
                if root.live { root.changed(root.drag); }
            }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.raised;
    animate background { duration: 150ms; }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.muted;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback picked(int);
    height: 34px;
    border-radius: self.height / 2;
    background: Theme.surface;
    min-width: row.preferred-width;
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for option[index] in root.options: Rectangle {
            border-radius: self.height / 2;
            min-width: label.preferred-width + 28px;
            background: index == root.selected ? Theme.hover : tap.has-hover ? Theme.raised : transparent;
            animate background { duration: 120ms; }
            label := Label {
                text: option;
                font-size: 12.5px;
                font-weight: 600;
                horizontal-alignment: center;
                color: index == root.selected ? Theme.text : Theme.muted;
            }
            tap := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = index;
                    root.picked(index);
                }
            }
        }
    }
}

/// A calm dropdown: the field looks like a text field, the list like the menus.
export component Select inherits Rectangle {
    in property <string> value;
    in property <[string]> options;
    callback picked(string);
    height: 36px;
    border-radius: Theme.radius-m;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        Label {
            text: root.value;
            font-size: 13.5px;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon { data: Icons.down; width: 15px; height: 15px; tint: Theme.muted; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        Rectangle {
            background: Theme.popup;
            border-radius: Theme.radius-m;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
            VerticalLayout {
                padding: 4px;
                for option in root.options: Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-s;
                    background: tap.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Label {
                            text: option;
                            font-size: 13px;
                            font-weight: option == root.value ? 600 : 500;
                            color: option == root.value || tap.has-hover ? Theme.text : Theme.muted;
                            horizontal-stretch: 1;
                        }
                        if option == root.value: VerticalLayout {
                            alignment: center;
                            Icon { data: Icons.check; width: 14px; height: 14px; tint: Theme.text; }
                        }
                    }
                    tap := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(option); }
                    }
                }
            }
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> secret;
    in property <length> radius: Theme.radius-m;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback committed(string);
    forward-focus: input;
    height: 40px;
    border-radius: root.radius;
    background: Theme.surface;
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                width: 17px;
                height: 17px;
                tint: input.has-focus ? Theme.text : Theme.muted;
            }
        }
        Rectangle {
            clip: true;
            input := TextInput {
                text <=> root.text;
                font-family: "Inter";
                font-size: 13.5px;
                color: Theme.text;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                accepted => {
                    root.accepted(self.text);
                    root.committed(self.text);
                }
                edited => { root.edited(self.text); }
                changed has-focus => {
                    if !self.has-focus { root.committed(self.text); }
                }
            }
            if root.text == "": Label {
                text: root.placeholder;
                color: Theme.faint;
                font-size: 13.5px;
            }
        }
    }
}
