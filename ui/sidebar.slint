import { ListView } from "std-widgets.slint";
import { Theme, Icons, Label, Icon, IconButton } from "theme.slint";

export struct PlaylistRow {
    id: int,
    name: string,
    count: int,
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> detail;
    in property <bool> active;
    in property <bool> compact;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius-m;
    background: root.active ? Theme.raised : touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px;
        padding-right: root.compact ? 0px : 12px;
        spacing: 12px;
        alignment: root.compact ? center : stretch;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                width: 18px;
                height: 18px;
                tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.muted;
            }
        }
        if !root.compact: Label {
            text: root.text;
            horizontal-stretch: 1;
            font-weight: root.active ? 600 : 500;
            color: root.active || touch.has-hover ? Theme.text : Theme.muted;
        }
        if root.detail != "" && !root.compact: Label {
            text: root.detail;
            color: Theme.faint;
            font-size: 11.5px;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[PlaylistRow]> playlists;
    in property <string> page;
    in property <int> active-playlist: -1;
    in property <bool> compact;
    in property <length> top-inset;
    in property <bool> can-back;
    in property <bool> can-forward;
    callback nav(int);
    callback navigate(string);
    callback playlist(int);
    callback create;
    width: root.compact ? 68px : 232px;
    background: Theme.sidebar;
    VerticalLayout {
        padding: 14px;
        padding-top: max(18px, root.top-inset + 6px);
        spacing: 2px;
        HorizontalLayout {
            height: 40px;
            padding-left: root.compact ? 0px : 12px;
            alignment: root.compact ? center : stretch;
            padding-bottom: 12px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
            if !root.compact: Label {
                text: "tonal";
                font-size: 19px;
                font-weight: 700;
                letter-spacing: -0.3px;
            }
            if !root.compact: Rectangle { horizontal-stretch: 1; }
            if !root.compact: VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.back; size: 28px; icon-size: 16px; tint: root.can-back ? Theme.muted : Theme.faint.with-alpha(0.5); clicked => { if root.can-back { root.nav(-1); } } }
            }
            if !root.compact: VerticalLayout {
                alignment: center;
                IconButton { icon: Icons.forward; size: 28px; icon-size: 16px; tint: root.can-forward ? Theme.muted : Theme.faint.with-alpha(0.5); clicked => { if root.can-forward { root.nav(1); } } }
            }
        }
        if root.compact && root.can-back: HorizontalLayout {
            alignment: center;
            height: 36px;
            IconButton { icon: Icons.back; size: 30px; icon-size: 16px; clicked => { root.nav(-1); } }
        }
        NavItem { compact: root.compact; icon: Icons.home; text: "Home"; active: root.page == "Home"; clicked => { root.navigate("Home"); } }
        NavItem { compact: root.compact; icon: Icons.search; text: "Search"; active: root.page == "Search"; clicked => { root.navigate("Search"); } }
        Rectangle { height: 10px; }
        if !root.compact: HorizontalLayout {
            padding-left: 12px;
            height: 26px;
            Label { text: "Library"; font-size: 11.5px; font-weight: 600; color: Theme.faint; }
        }
        NavItem { compact: root.compact; icon: Icons.heart; text: "Liked songs"; active: root.page == "Liked songs"; clicked => { root.navigate("Liked songs"); } }
        NavItem { compact: root.compact; icon: Icons.folder; text: "Local files"; active: root.page == "Local files"; clicked => { root.navigate("Local files"); } }
        NavItem { compact: root.compact; icon: Icons.download; text: "Downloads"; active: root.page == "Downloads"; clicked => { root.navigate("Downloads"); } }
        Rectangle { height: 10px; }
        if root.compact: Rectangle { height: 10px; }
        if !root.compact: HorizontalLayout {
            height: 30px;
            padding-left: 12px;
            Label { text: "Playlists"; font-size: 11.5px; font-weight: 600; color: Theme.faint; }
            IconButton {
                icon: Icons.plus;
                size: 26px;
                icon-size: 15px;
                clicked => { root.create(); }
            }
        }
        if root.compact: Rectangle { vertical-stretch: 1; }
        if !root.compact: Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            if root.playlists.length > 0: ListView {
                width: parent.width;
                height: parent.height;
                for list in root.playlists: NavItem {
                    text: list.name;
                    detail: list.count;
                    active: root.page == "Playlist" && root.active-playlist == list.id;
                    clicked => { root.playlist(list.id); }
                }
            }
        }
        NavItem { compact: root.compact; icon: Icons.settings; text: "Settings"; active: root.page == "Settings"; clicked => { root.navigate("Settings"); } }
    }
}
