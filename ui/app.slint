import { Theme, Icons, Label, Icon, IconButton, Button, Segmented, TextField } from "theme.slint";
import { Sidebar, PlaylistRow } from "sidebar.slint";
import { TrackList, TrackRow } from "track-list.slint";
import { PlayerBar } from "player-bar.slint";
import { SettingsView, SettingRow, LyricsView, LyricRow } from "views.slint";
import { Dialog } from "dialogs.slint";
import { ArtistView, AlbumView, AlbumGrid, StatsView, CardRow } from "browse.slint";
import { EqPanel } from "equalizer.slint";
import { NowPlayingView } from "now-playing.slint";
import { ThemesView, ThemeStudio, ThemeCard, PaletteRow } from "themes.slint";

import { WaveLook } from "visualizer.slint";
export { TrackRow, PlaylistRow, SettingRow, LyricRow, CardRow, Theme, ThemeStudio, ThemeCard, PaletteRow, WaveLook }

export component AppWindow inherits Window {
    in property <string> window-title: "Tonal";
    in property <length> titlebar-inset: 0px;
    callback start-drag();
    title: root.window-title;
    icon: @image-url("icon.png");
    preferred-width: 1240px;
    preferred-height: 780px;
    min-width: root.mini ? 340px : 940px;
    min-height: (root.mini ? 150px : 520px) + root.titlebar-inset;
    background: Theme.background;
    default-font-family: "Inter";

    in property <[TrackRow]> tracks;
    in property <[TrackRow]> queue;
    in property <[PlaylistRow]> playlists;
    in property <[SettingRow]> settings;
    in property <[LyricRow]> lyrics;
    in property <int> lyric-index: -1;
    in property <int> queue-current: -1;
    in-out property <string> query;
    in-out property <string> page: "Home";
    in property <string> heading: "Home";
    in-out property <string> status;
    in property <bool> loading;
    in property <bool> playlist-view;
    in property <int> active-playlist: -1;
    in property <string> now-id;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> now-art;
    in property <bool> now-liked;
    in property <bool> paused: true;
    in property <bool> shuffle;
    in property <string> repeat: "Off";
    in property <float> position;
    in property <float> duration: 1;
    in property <float> volume: 80;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <bool> waves;
    in property <string> wave-back;
    in property <string> wave-front;
    in property <string> wave-back-line;
    in property <string> wave-haze;
    in property <string> wave-glow;
    in property <string> wave-line;
    in property <bool> wave-resting: true;
    out property <length> wave-width: bar.width;
    out property <length> wave-height: bar.wave-height;
    in-out property <bool> mini;
    in-out property <string> panel;
    in-out property <string> dialog;
    in-out property <string> dialog-heading;
    in-out property <string> dialog-value;
    in-out property <int> source;
    in-out property <int> home-tab;
    in-out property <int> search-focus;
    in-out property <bool> typing;
    private property <bool> wide-list: true;
    private property <bool> slim: false;
    private property <bool> narrow: false;
    in property <bool> buffering;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <[string]> now-artists;
    in property <bool> now-album;
    in property <string> now-quality;
    in property <bool> bit-perfect;
    in property <string> artist-name;
    in property <image> artist-image;
    in property <string> artist-source;
    in property <bool> browse-loading;
    in property <[CardRow]> albums;
    in property <[CardRow]> singles;
    in property <[CardRow]> similar;
    in property <string> album-title;
    in property <string> album-kind;
    in property <string> album-meta;
    in property <[string]> album-artists;
    in property <image> album-cover;
    in property <[float]> eq-gains;
    in property <string> eq-preset: "Flat";
    in property <bool> eq-comparing;
    in property <string> eq-backdrop;
    in property <string> eq-fill;
    in property <string> eq-haze;
    in property <string> eq-glow;
    in property <string> eq-line;
    in property <[float]> eq-spots;
    in property <[string]> eq-labels;
    in property <string> eq-correction;
    in property <string> eq-headphone;
    in-out property <string> eq-headphone-query;
    in property <[string]> eq-headphone-results;
    in property <int> eq-headphone-show;
    in-out property <length> eq-width;
    in-out property <length> eq-height;
    in-out property <bool> now-open;
    in property <image> now-big-art;
    in property <string> now-album-title;
    in property <string> now-year;
    out property <length> stage-width;
    out property <length> stage-height;
    out property <length> now-art-size;
    in property <color> album-color;
    in property <bool> album-tint;
    in property <bool> album-colors: true;
    in-out property <int> local-view;
    in-out property <int> local-sort;
    in property <[CardRow]> local-albums;
    in-out property <int> stats-period;
    in property <[CardRow]> top-artists;
    in property <[CardRow]> top-albums;
    /// Waves and equalizer tint: a soft color from the cover, or the theme's white.
    private property <color> wave-accent: root.album-colors && root.album-tint ? root.album-color : Theme.text;
    animate wave-accent { duration: 600ms; easing: ease-in-out; }
    changed now-id => { root.now-changed(); }
    // Opening is handled by the view once it knows its size.
    changed now-open => {
        if !root.now-open { root.now-changed(); }
    }
    // The cover is rounded in its pixels, so it is redrawn after a resize settles.
    art-resize := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            self.running = false;
            root.now-changed();
        }
    }

    function update-wide() {
        root.slim = root.width - (root.panel != "" ? 320px : 0px) < 900px;
        root.narrow = root.width - (root.slim ? 128px : 292px) - (root.panel != "" ? 320px : 0px) < 600px;
        root.wide-list = root.width - (root.slim ? 128px : 292px) - (root.panel != "" ? 320px : 0px) > 760px;
    }
    changed width => { root.update-wide(); }
    changed panel => { root.update-wide(); }
    init => { root.update-wide(); }

    callback search(string);
    callback navigate(string);
    callback playlist(int);
    callback play(int);
    callback track-action(int, string);
    callback menu(int);
    callback command(string);
    callback seek(float);
    callback volume-change(float);
    callback setting-change(string, string);
    callback dialog-submit(string);
    callback menu-action(string);
    callback add-playlist(int);
    callback queue-action(int, string);
    callback queue-move(int, int);
    callback shortcut(string, bool, bool);
    callback open-artist(string, int, int);
    callback open-album(string, int);
    callback open-card(string, int);
    callback artist-action(string);
    callback album-action(string);
    callback eq-choose(string);
    callback eq-drag(int, float, float);
    callback eq-headphones-open();
    callback eq-headphones-search(string);
    callback eq-headphones-pick(int);
    callback eq-headphones-clear();
    callback eq-release();
    callback eq-reset(int);
    callback eq-compare(bool);
    callback eq-resized();
    callback nav(int);
    callback now-changed();

    public function focus-search() {
        root.search-focus += 1;
    }

    private property <string> empty-text: root.page == "Home" ? "Play something and it shows up here"
        : root.page == "Search" ? (root.query == "" ? "Find any song" : root.loading ? "" : "No results")
        : root.page == "Liked songs" ? "No liked songs yet"
        : root.page == "Local files" ? "Add a music folder in Settings"
        : root.page == "Downloads" ? "No downloads yet"
        : root.page == "Playlist" ? "Empty playlist"
        : "";

    debounce := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if root.query != "" { root.search(root.query); }
        }
    }

    if ThemeStudio.on: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: ThemeStudio.image;
        image-fit: fill;
    }
    if ThemeStudio.on && ThemeStudio.style == 1 && !root.mini: Rectangle {
        x: 0;
        y: 0;
        width: root.slim ? 68px : 232px;
        height: bar.y;
        clip: true;
        Image { x: 0; y: 0; width: root.width; height: root.height; source: ThemeStudio.frost; image-fit: fill; }
    }
    if ThemeStudio.on && ThemeStudio.style == 1 && !root.mini: Rectangle {
        x: 0;
        y: bar.y;
        width: root.width;
        height: root.height - bar.y;
        clip: true;
        Image { x: 0; y: -bar.y; width: root.width; height: root.height; source: ThemeStudio.frost; image-fit: fill; }
    }
    if ThemeStudio.on && ThemeStudio.style == 1 && !root.mini && root.panel != "" && !root.now-open: Rectangle {
        x: root.width - 320px;
        y: 0;
        width: 320px;
        height: bar.y;
        clip: true;
        Image { x: -parent.x; y: 0; width: root.width; height: root.height; source: ThemeStudio.frost; image-fit: fill; }
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "f") {
                    root.page = "Search";
                    root.navigate("Search");
                    root.focus-search();
                    return accept;
                }
                root.shortcut(event.text, true, root.typing);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.nav(-1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.RightArrow) {
                root.nav(1);
                return accept;
            }
            if (event.text == Key.Escape && ThemeStudio.peek) {
                ThemeStudio.peek = false;
                return accept;
            }
            if (event.text == Key.Escape && root.dialog != "") {
                root.dialog = "";
                return accept;
            }
            if (event.text == Key.Escape && root.now-open) {
                root.now-open = false;
                return accept;
            }
            if (!root.typing) {
                root.shortcut(event.text, false, false);
            }
            return reject;
        }

        if root.titlebar-inset > 0: TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.titlebar-inset;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.start-drag();
                }
            }
        }
        VerticalLayout {
            spacing: 0px;
            padding-top: root.mini ? root.titlebar-inset : 0px;
            if !root.mini: HorizontalLayout {
                spacing: 0px;
                Sidebar {
                    top-inset: root.titlebar-inset;
                    compact: root.slim;
                    page: root.page;
                    playlists: root.playlists;
                    active-playlist: root.active-playlist;
                    can-back: root.can-back;
                    can-forward: root.can-forward;
                    nav(d) => { root.nav(d); }
                    navigate(p) => {
                        debounce.running = false;
                        root.now-open = false;
                        root.page = p;
                        root.navigate(p);
                    }
                    playlist(id) => { root.playlist(id); }
                    create => {
                        root.dialog-heading = "New playlist";
                        root.dialog-value = "";
                        root.dialog = "create";
                    }
                }
                // Hidden, not removed, under the now playing view so lists keep their place.
                Rectangle {
                    horizontal-stretch: 1;
                    visible: !root.now-open;
                    VerticalLayout {
                        padding-left: root.slim ? 22px : 32px;
                        padding-right: root.slim ? 18px : 28px;
                        padding-top: 24px;
                        padding-bottom: 8px;
                        spacing: 16px;
                        if root.page != "Search" && root.page != "Home" && root.page != "Artist" && root.page != "Album": HorizontalLayout {
                            height: 44px;
                            spacing: 8px;
                            Label {
                                horizontal-stretch: 1;
                                text: root.heading;
                                font-size: 20px;
                                font-weight: 650;
                                letter-spacing: -0.2px;
                            }
                            if root.playlist-view: VerticalLayout { alignment: center; Button { text: "Play"; icon: Icons.play; primary: true; clicked => { root.play(0); } } }
                            if root.playlist-view: VerticalLayout { alignment: center; IconButton { icon: Icons.shuffle; clicked => { root.command("shuffle-play"); } } }
                            if root.playlist-view: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.pencil;
                                    clicked => {
                                        root.dialog-heading = "Rename playlist";
                                        root.dialog-value = root.heading;
                                        root.dialog = "rename";
                                    }
                                }
                            }
                            if root.playlist-view: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.trash;
                                    clicked => {
                                        root.dialog-heading = "Delete \"" + root.heading + "\"?";
                                        root.dialog-value = "";
                                        root.dialog = "delete";
                                    }
                                }
                            }
                            if root.page == "Local files" && root.local-view == 1: VerticalLayout {
                                alignment: center;
                                Segmented {
                                    options: ["Artist", "Year", "Recent"];
                                    selected <=> root.local-sort;
                                    picked(i) => { root.command("sort:" + i); }
                                }
                            }
                            if root.page == "Local files": VerticalLayout {
                                alignment: center;
                                padding-left: 4px;
                                Segmented {
                                    options: ["Songs", "Albums"];
                                    selected <=> root.local-view;
                                    picked(i) => { root.command(i == 0 ? "local:songs" : "local:albums"); }
                                }
                            }
                        }
                        if root.page == "Search": HorizontalLayout {
                            spacing: 12px;
                            TextField {
                                in property <int> request: root.search-focus;
                                changed request => { self.focus(); }
                                changed focused => { root.typing = self.focused; }
                                init => { self.focus(); }
                                max-width: 560px;
                                min-width: 160px;
                                height: 44px;
                                radius: 22px;
                                icon: Icons.search;
                                placeholder: "Songs, artists, albums";
                                text <=> root.query;
                                edited => {
                                    debounce.running = false;
                                    debounce.running = true;
                                }
                                accepted(text) => {
                                    debounce.running = false;
                                    root.search(text);
                                }
                            }
                            if !root.narrow: VerticalLayout {
                                alignment: center;
                                Segmented {
                                    options: ["YouTube", "SoundCloud", "Audius", "Local"];
                                    selected <=> root.source;
                                    picked => {
                                        if root.query != "" { root.search(root.query); }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.page == "Search" && root.narrow: HorizontalLayout {
                            alignment: start;
                            Segmented {
                                options: ["YouTube", "SoundCloud", "Audius", "Local"];
                                selected <=> root.source;
                                picked => {
                                    if root.query != "" { root.search(root.query); }
                                }
                            }
                        }
                        if root.page == "Home": HorizontalLayout {
                            spacing: 12px;
                            Segmented {
                                options: ["Recent", "Most played", "Stats"];
                                selected <=> root.home-tab;
                                picked(i) => { root.command(i == 0 ? "recent" : i == 1 ? "most-played" : "stats:" + root.stats-period); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.home-tab == 2: Segmented {
                                options: ["This month", "All time"];
                                selected <=> root.stats-period;
                                picked(i) => { root.command("stats:" + i); }
                            }
                            if root.home-tab != 2: Button {
                                text: "Import playlist";
                                icon: Icons.import;
                                clicked => {
                                    root.dialog-heading = "Import from Spotify";
                                    root.dialog-value = "";
                                    root.dialog = "import";
                                }
                            }
                        }
                        if root.page == "Artist": ArtistView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            name: root.artist-name;
                            image: root.artist-image;
                            source: root.artist-source;
                            loading: root.browse-loading;
                            tracks: root.tracks;
                            playlists: root.playlists;
                            now-id: root.now-id;
                            wide: root.wide-list;
                            albums: root.albums;
                            singles: root.singles;
                            similar: root.similar;
                            action(a) => { root.artist-action(a); }
                            play(i) => { root.play(i); }
                            like(i) => { root.track-action(i, "Like / Unlike"); }
                            open-menu(i) => { root.menu(i); }
                            menu-action(a) => { root.menu-action(a); }
                            add-playlist(id) => { root.add-playlist(id); }
                            artist(i, w) => { root.open-artist("tracks", i, w); }
                            album(i) => { root.open-album("tracks", i); }
                            open-card(k, i) => { root.open-card(k, i); }
                        }
                        if root.page == "Album": AlbumView {
                            vertical-stretch: 1;
                            title: root.album-title;
                            kind: root.album-kind;
                            meta: root.album-meta;
                            artists: root.album-artists;
                            cover: root.album-cover;
                            loading: root.browse-loading;
                            tracks: root.tracks;
                            playlists: root.playlists;
                            now-id: root.now-id;
                            wide: root.wide-list;
                            action(a) => { root.album-action(a); }
                            open-artist(i) => { root.open-artist("album", -1, i); }
                            play(i) => { root.play(i); }
                            like(i) => { root.track-action(i, "Like / Unlike"); }
                            open-menu(i) => { root.menu(i); }
                            menu-action(a) => { root.menu-action(a); }
                            add-playlist(id) => { root.add-playlist(id); }
                            artist(i, w) => { root.open-artist("tracks", i, w); }
                        }
                        if root.page == "Home" && root.home-tab == 2: StatsView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            artists: root.top-artists;
                            albums: root.top-albums;
                            open(k, i) => { root.open-card(k, i); }
                        }
                        if root.page == "Local files" && root.local-view == 1: AlbumGrid {
                            vertical-stretch: 1;
                            min-height: 120px;
                            cards: root.local-albums;
                            empty-text: root.empty-text;
                            open(i) => { root.open-card("local-album", i); }
                        }
                        if root.page != "Settings" && root.page != "Themes" && root.page != "Artist" && root.page != "Album" && !(root.page == "Home" && root.home-tab == 2) && !(root.page == "Local files" && root.local-view == 1): TrackList {
                            vertical-stretch: 1;
                            min-height: 120px;
                            tracks: root.tracks;
                            playlists: root.playlists;
                            now-id: root.now-id;
                            wide: root.wide-list;
                            playlist-view: root.playlist-view;
                            download-view: root.page == "Downloads";
                            empty-text: root.empty-text;
                            play(i) => { root.play(i); }
                            like(i) => { root.track-action(i, "Like / Unlike"); }
                            open-menu(i) => { root.menu(i); }
                            menu-action(a) => { root.menu-action(a); }
                            add-playlist(id) => { root.add-playlist(id); }
                            artist(i, w) => { root.open-artist("tracks", i, w); }
                            album(i) => { root.open-album("tracks", i); }
                        }
                        if root.page == "Themes": ThemesView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            save => {
                                root.dialog-heading = "Save theme";
                                root.dialog-value = ThemeStudio.name;
                                root.dialog = "theme-save";
                            }
                        }
                        if root.page == "Settings": SettingsView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            fields: root.settings;
                            change(k, v) => { root.setting-change(k, v); }
                            command(c) => { root.command(c); }
                        }
                    }
                }
                if root.panel != "": Rectangle {
                    width: 320px;
                    visible: !root.now-open;
                    background: Theme.panel;
                    Rectangle { x: 0; width: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding-top: 24px;
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 12px;
                        HorizontalLayout {
                            height: 44px;
                            padding-left: 8px;
                            Label {
                                text: root.panel == "queue" ? "Queue" : root.panel == "eq" ? "Equalizer" : "Lyrics";
                                font-size: 17px;
                                font-weight: 700;
                            }
                            if root.panel == "eq": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: compare.pressed ? Theme.text : compare.has-hover ? Theme.hover : transparent;
                                    animate background { duration: 120ms; }
                                    Icon {
                                        data: Icons.compare;
                                        width: 16px;
                                        height: 16px;
                                        tint: compare.pressed ? Theme.on-accent : compare.has-hover ? Theme.text : Theme.muted;
                                    }
                                    compare := TouchArea {
                                        mouse-cursor: pointer;
                                        changed pressed => { root.eq-compare(self.pressed); }
                                    }
                                }
                            }
                            if root.panel == "queue" && root.queue.length > 0: VerticalLayout {
                                alignment: center;
                                IconButton { icon: Icons.trash; size: 30px; icon-size: 16px; clicked => { root.command("clear-queue"); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: Icons.close; size: 30px; icon-size: 16px; clicked => { root.panel = ""; } }
                            }
                        }
                        if root.panel == "queue": TrackList {
                            vertical-stretch: 1;
                            min-height: 80px;
                            compact: true;
                            tracks: root.queue;
                            current: root.queue-current;
                            empty-text: "Queue is empty";
                            play(i) => { root.queue-action(i, "jump"); }
                            remove(i) => { root.queue-action(i, "remove"); }
                            reorder(i, d) => { root.queue-move(i, d); }
                            artist(i, w) => { root.open-artist("queue", i, w); }
                        }
                        if root.panel == "eq": EqPanel {
                            padding-left: 8px;
                            accent: root.wave-accent;
                            init => {
                                root.eq-width = self.graph-width;
                                root.eq-height = self.graph-height;
                                root.eq-resized();
                            }
                            changed graph-width => {
                                root.eq-width = self.graph-width;
                                root.eq-height = self.graph-height;
                                root.eq-resized();
                            }
                            gains: root.eq-gains;
                            preset: root.eq-preset;
                            comparing: root.eq-comparing;
                            bypassed: root.bit-perfect;
                            backdrop: root.eq-backdrop;
                            fill: root.eq-fill;
                            haze: root.eq-haze;
                            glow: root.eq-glow;
                            line: root.eq-line;
                            spots: root.eq-spots;
                            labels: root.eq-labels;
                            correction: root.eq-correction;
                            headphone: root.eq-headphone;
                            headphone-query <=> root.eq-headphone-query;
                            headphone-results: root.eq-headphone-results;
                            show-search: root.eq-headphone-show;
                            changed typing => { root.typing = self.typing; }
                            headphones-open => { root.eq-headphones-open(); }
                            headphones-search(q) => { root.eq-headphones-search(q); }
                            headphones-pick(i) => { root.eq-headphones-pick(i); }
                            headphones-clear => { root.eq-headphones-clear(); }
                            choose(name) => { root.eq-choose(name); }
                            drag(i, g, s) => { root.eq-drag(i, g, s); }
                            release => { root.eq-release(); }
                            reset(i) => { root.eq-reset(i); }
                        }
                        if root.panel == "eq": Rectangle { vertical-stretch: 1; }
                        if root.panel == "lyrics": LyricsView {
                            vertical-stretch: 1;
                            min-height: 80px;
                            lines: root.lyrics;
                            active: root.lyric-index;
                            seek(t) => { root.seek(t); }
                        }
                    }
                }
            }
            bar := PlayerBar {
                vertical-stretch: root.mini ? 1 : 0;
                title: root.now-title;
                artist: root.now-artist;
                art: root.now-art;
                has-track: root.now-id != "";
                liked: root.now-liked;
                paused: root.paused;
                shuffle: root.shuffle;
                repeat: root.repeat;
                position: root.position;
                duration: root.duration;
                volume: root.volume;
                elapsed: root.elapsed;
                total: root.total;
                mini: root.mini;
                panel: root.panel;
                waves: root.waves && !root.now-open;
                wave-accent: root.wave-accent;
                wave-back: root.wave-back;
                wave-front: root.wave-front;
                wave-back-line: root.wave-back-line;
                wave-haze: root.wave-haze;
                wave-glow: root.wave-glow;
                wave-line: root.wave-line;
                wave-resting: root.wave-resting;
                artists: root.now-artists;
                has-album: root.now-album;
                quality: root.now-quality;
                fixed-volume: root.bit-perfect;
                open-artist(i) => { root.open-artist("now", 0, i); }
                open-album => { root.open-album("now", 0); }
                command(c) => { root.command(c); }
                seek(v) => { root.seek(v); }
                volume-change(v) => { root.volume-change(v); }
            }
        }

        if root.now-open && !root.mini: NowPlayingView {
            x: root.slim ? 68px : 232px;
            y: 0;
            width: root.width - self.x;
            height: root.height - bar.height;
            init => {
                root.stage-width = self.width;
                root.stage-height = self.stage-height;
                root.now-art-size = self.art-size;
                root.now-changed();
            }
            changed width => { root.stage-width = self.width; }
            changed stage-height => { root.stage-height = self.stage-height; }
            changed art-size => {
                root.now-art-size = self.art-size;
                art-resize.running = false;
                art-resize.running = true;
            }
            art: root.now-big-art;
            title: root.now-title;
            artists: root.now-artists;
            album: root.now-album-title;
            year: root.now-year;
            lyrics: root.lyrics;
            lyric-index: root.lyric-index;
            slim: root.slim;
            waves: root.waves;
            wave-back: root.wave-back;
            wave-front: root.wave-front;
            wave-back-line: root.wave-back-line;
            wave-haze: root.wave-haze;
            wave-glow: root.wave-glow;
            wave-line: root.wave-line;
            wave-resting: root.wave-resting;
            accent: root.wave-accent;
            close => { root.now-open = false; }
            open-artist(i) => {
                root.now-open = false;
                root.open-artist("now", 0, i);
            }
            open-album => {
                root.now-open = false;
                root.open-album("now", 0);
            }
            seek(t) => { root.seek(t); }
        }
    }

    if root.loading || root.buffering: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 2px;
        clip: true;
        Rectangle {
            width: parent.width * 0.3;
            x: parent.width * (mod(animation-tick() / 1ms, 1400) / 1400 * 1.3 - 0.3);
            background: @linear-gradient(90deg, #ffffff00 0%, Theme.text.with-alpha(0.7) 50%, #ffffff00 100%);
        }
    }

    if root.status != "" && !root.mini: Rectangle {
        y: root.height - 96px - self.height - 16px;
        x: (root.width - self.width) / 2;
        height: 36px;
        width: min(toast.preferred-width + 36px, root.width - 48px);
        border-radius: 18px;
        background: Theme.popup;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000070;
        toast := Label {
            text: root.status;
            font-size: 12.5px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }

    if root.dialog != "": Dialog {
        kind: root.dialog;
        heading: root.dialog-heading;
        value <=> root.dialog-value;
        dismiss => { root.dialog = ""; }
        submit(v) => { root.dialog-submit(v); }
    }

    if ThemeStudio.peek && ThemeStudio.on: Rectangle {
        Image { width: root.width; height: root.height; source: ThemeStudio.image; image-fit: fill; }
        TouchArea { clicked => { ThemeStudio.peek = false; } }
        Rectangle {
            y: root.height - 64px;
            width: hint.preferred-width + 32px;
            height: 32px;
            border-radius: 16px;
            background: #00000080;
            hint := Label { text: "Click anywhere or press Esc to come back"; font-size: 12px; color: #ffffffd0; }
        }
    }
}
