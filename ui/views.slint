import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Label, Icon, Button, Switch, TextField } from "theme.slint";

export struct SettingRow {
    key: string,
    label: string,
    value: string,
    hint: string,
    kind: string,
    secret: bool,
    header: string,
    first: bool,
    last: bool,
}

export struct LyricRow {
    text: string,
    active: bool,
    time: float,
}

export component SettingsView inherits Rectangle {
    in property <[SettingRow]> fields;
    callback change(string, string);
    callback command(string);
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding-bottom: 32px;
            for field in root.fields: VerticalLayout {
                if field.header != "": Label {
                    text: field.header;
                    height: 48px;
                    vertical-alignment: bottom;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                }
                if field.header != "": Rectangle { height: 10px; }
                row := TouchArea {
                    max-width: 760px;
                    height: 58px;
                    Rectangle {
                        background: Theme.surface;
                        border-top-left-radius: field.first ? Theme.radius-l : 0px;
                        border-top-right-radius: field.first ? Theme.radius-l : 0px;
                        border-bottom-left-radius: field.last ? Theme.radius-l : 0px;
                        border-bottom-right-radius: field.last ? Theme.radius-l : 0px;
                    }
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 20px;
                        Label {
                            text: field.label;
                            font-weight: 500;
                            min-width: 140px;
                        }
                        Label {
                            text: field.hint;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            font-size: 11.5px;
                            color: Theme.faint;
                            opacity: row.has-hover ? 1 : 0;
                            animate opacity { duration: 140ms; easing: ease-out; }
                        }
                        if field.kind == "toggle": VerticalLayout {
                            alignment: center;
                            Switch {
                                checked: field.value == "true";
                                toggled(on) => { root.change(field.key, on ? "true" : "false"); }
                            }
                        }
                        if field.kind == "text": VerticalLayout {
                            alignment: center;
                            TextField {
                                width: 280px;
                                height: 36px;
                                text: field.value;
                                secret: field.secret;
                                committed(value) => {
                                    if value != field.value { root.change(field.key, value); }
                                }
                            }
                        }
                        if field.kind == "action": VerticalLayout {
                            alignment: center;
                            Button {
                                text: field.value;
                                clicked => { root.command(field.key); }
                            }
                        }
                    }
                    if !field.last: Rectangle {
                        x: 18px;
                        y: parent.height - 1px;
                        width: parent.width - 36px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }
        }
    }
}

export component LyricsView inherits Rectangle {
    in property <[LyricRow]> lines;
    in property <int> active: -1;
    callback seek(float);
    private property <length> line-height: 52px;
    private property <bool> synced: root.lines.length > 0 && root.lines[0].time >= 0;
    private property <bool> empty: root.lines.length == 0 || (root.lines.length == 1 && root.lines[0].text == "No lyrics found");
    private property <bool> following: true;

    function follow() {
        if !root.synced || !root.following || root.active < 0 {
            return;
        }
        scroller.content-y = clamp(
            scroller.visible-height / 2 - root.line-height / 2 - root.active * root.line-height,
            min(0px, scroller.visible-height - list.preferred-height),
            0px);
    }

    changed active => { root.follow(); }
    changed lines => { root.follow(); }
    changed height => { root.follow(); }
    init => { root.follow(); }

    resume := Timer {
        interval: 4s;
        running: false;
        triggered => {
            self.running = false;
            root.following = true;
            root.follow();
        }
    }

    if root.empty: VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon { data: Icons.lyrics; width: 26px; height: 26px; tint: Theme.faint; }
        }
        Label {
            text: "No lyrics";
            horizontal-alignment: center;
            font-size: 13px;
            color: Theme.faint;
        }
    }

    scroller := ScrollView {
        visible: !root.empty;
        width: root.width;
        height: root.height;
        animate content-y { duration: 420ms; easing: ease-in-out; }
        scrolled => {
            root.following = false;
            resume.running = false;
            resume.running = true;
        }
        list := VerticalLayout {
            width: scroller.visible-width;
            padding-left: 8px;
            padding-right: 12px;
            padding-bottom: root.synced ? scroller.visible-height / 2 : 24px;
            if !root.synced: Label {
                text: "Not synced";
                height: 28px;
                font-size: 11.5px;
                color: Theme.faint;
            }
            for line[index] in root.lines: row := Rectangle {
                height: root.synced ? root.line-height : max(24px, text.preferred-height + 4px);
                border-radius: Theme.radius-m;
                background: root.synced && tap.has-hover ? Theme.surface : transparent;
                text := Label {
                    x: 10px;
                    width: parent.width - 20px;
                    text: line.text;
                    wrap: word-wrap;
                    overflow: root.synced ? elide : clip;
                    font-size: root.synced ? 16px : 14px;
                    font-weight: line.active ? 700 : 500;
                    color: !root.synced ? Theme.muted : line.active ? Theme.text : index < root.active ? Theme.faint : Theme.muted;
                    animate color { duration: 220ms; }
                }
                tap := TouchArea {
                    enabled: root.synced;
                    mouse-cursor: root.synced ? pointer : default;
                    clicked => {
                        root.following = true;
                        resume.running = false;
                        root.seek(line.time);
                    }
                }
            }
        }
    }
}
