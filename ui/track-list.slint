import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Label, Icon, IconButton } from "theme.slint";
import { PlaylistRow } from "sidebar.slint";

export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    source: string,
    liked: bool,
    art: image,
}

export component Artwork inherits Rectangle {
    in property <image> source;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: round(root.size * 0.15 / 1px) * 1px;
    background: Theme.raised;
    clip: true;
    if root.source.width == 0: Icon {
        data: Icons.music;
        width: root.size * 0.42;
        height: root.size * 0.42;
        tint: Theme.faint;
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
}

component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-m;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                width: 16px;
                height: 16px;
                tint: root.danger ? #f2555a : touch.has-hover ? Theme.text : Theme.muted;
            }
        }
        Label {
            text: root.text;
            color: root.danger ? #f2555a : Theme.text;
            font-size: 13px;
        }
    }
}

component MenuDivider inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

export component TrackList inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <[PlaylistRow]> playlists;
    in property <string> now-id;
    in property <int> current: -1;
    in property <bool> compact;
    in property <bool> playlist-view;
    in property <bool> download-view;
    in property <string> empty-text: "Nothing here yet";
    callback play(int);
    callback like(int);
    callback open-menu(int);
    callback menu-action(string);
    callback add-playlist(int);
    callback reorder(int, int);
    callback remove(int);
    private property <length> menu-x;
    private property <length> menu-y;
    private property <int> menu-index: -1;
    in property <bool> wide: true;

    function show-menu(index: int, x: length, y: length) {
        root.menu-index = index;
        root.menu-x = min(x, root.width - 232px);
        root.menu-y = min(y, max(0px, root.height - 420px));
        root.open-menu(index);
        menu.show();
    }

    Rectangle {
        VerticalLayout {
            spacing: 4px;
            if root.tracks.length == 0: Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { data: Icons.music; width: 28px; height: 28px; tint: Theme.faint; }
                    }
                    Label {
                        text: root.empty-text;
                        color: Theme.faint;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            if root.tracks.length > 0: ListView {
                vertical-stretch: 1;
                for track[index] in root.tracks: item := Rectangle {
                    private property <bool> playing: root.compact ? index == root.current : track.id == root.now-id && track.id != "";
                    height: root.compact ? 54px : 56px;
                    border-radius: Theme.radius-l;
                animate background { duration: 100ms; }
                    background: row.has-hover ? Theme.surface : self.playing && root.compact ? Theme.raised : transparent;
                    row := TouchArea {
                        double-clicked => { root.play(index); }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right && !root.compact {
                                root.show-menu(index, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                            }
                        }
                        HorizontalLayout {
                            padding-left: root.compact ? 8px : 10px;
                            padding-right: root.compact ? 4px : 10px;
                            spacing: root.compact ? 10px : 14px;
                            if !root.compact: Rectangle {
                                width: 28px;
                                if row.has-hover: IconButton {
                                    icon: Icons.play;
                                    filled: true;
                                    size: 28px;
                                    icon-size: 14px;
                                    tint: Theme.text;
                                    clicked => { root.play(index); }
                                }
                                if !row.has-hover && item.playing: Icon {
                                    data: Icons.music;
                                    width: 15px;
                                    height: 15px;
                                    tint: Theme.accent;
                                }
                                if !row.has-hover && !item.playing: Label {
                                    text: index + 1;
                                    color: Theme.faint;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Artwork { source: track.art; size: root.compact ? 38px : 40px; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 3;
                                alignment: center;
                                spacing: 3px;
                                Label {
                                    text: track.title;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                    color: item.playing ? Theme.accent : Theme.text;
                                }
                                Label {
                                    text: track.artist;
                                    font-size: 12px;
                                    color: Theme.muted;
                                }
                            }
                            if !root.compact && root.wide: VerticalLayout {
                                horizontal-stretch: 2;
                                alignment: center;
                                Label {
                                    text: track.album;
                                    horizontal-alignment: left;
                                    color: Theme.muted;
                                    font-size: 12.5px;
                                }
                            }
                            if !root.compact && root.wide: VerticalLayout {
                                width: 84px;
                                alignment: center;
                                HorizontalLayout {
                                    alignment: start;
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.surface;
                                        min-width: tag.preferred-width + 16px;
                                        tag := Label {
                                            text: track.source;
                                            font-size: 10.5px;
                                            font-weight: 500;
                                            color: Theme.muted;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                            if !root.compact: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.heart;
                                    size: 30px;
                                    icon-size: 16px;
                                    filled: track.liked;
                                    tint: track.liked ? Theme.accent : Theme.muted;
                                    opacity: track.liked || row.has-hover ? 1 : 0;
                                    clicked => { root.like(index); }
                                }
                            }
                            if !root.compact: Label {
                                text: track.duration;
                                width: 44px;
                                horizontal-alignment: right;
                                color: Theme.muted;
                                font-size: 12.5px;
                            }
                            if !root.compact: VerticalLayout {
                                alignment: center;
                                more := IconButton {
                                    icon: Icons.more;
                                    size: 30px;
                                    opacity: row.has-hover ? 1 : 0;
                                    clicked => {
                                        root.show-menu(index, self.absolute-position.x - root.absolute-position.x - 190px, self.absolute-position.y - root.absolute-position.y + 30px);
                                    }
                                }
                            }
                            if root.compact: HorizontalLayout {
                                alignment: end;
                                opacity: row.has-hover ? 1 : 0;
                                VerticalLayout { alignment: center; IconButton { icon: Icons.up; size: 26px; icon-size: 15px; clicked => { root.reorder(index, -1); } } }
                                VerticalLayout { alignment: center; IconButton { icon: Icons.down; size: 26px; icon-size: 15px; clicked => { root.reorder(index, 1); } } }
                                VerticalLayout { alignment: center; IconButton { icon: Icons.close; size: 26px; icon-size: 15px; clicked => { root.remove(index); } } }
                            }
                        }
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        Rectangle {
            background: Theme.popup;
            border-radius: Theme.radius-l;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
            VerticalLayout {
                padding: 4px;
                MenuItem { icon: Icons.play; text: "Play"; clicked => { root.menu-action("Play"); } }
                MenuItem { icon: Icons.next-up; text: "Play next"; clicked => { root.menu-action("Play next"); } }
                MenuItem { icon: Icons.queue; text: "Add to queue"; clicked => { root.menu-action("Add to queue"); } }
                MenuItem { icon: Icons.radio; text: "Start radio"; clicked => { root.menu-action("Start radio"); } }
                MenuDivider { }
                MenuItem {
                    icon: Icons.heart;
                    text: root.menu-index >= 0 && root.menu-index < root.tracks.length && root.tracks[root.menu-index].liked ? "Remove from liked" : "Like";
                    clicked => { root.menu-action("Like / Unlike"); }
                }
                if !root.download-view: MenuItem { icon: Icons.download; text: "Download"; clicked => { root.menu-action("Download"); } }
                if root.download-view: MenuItem { icon: Icons.trash; text: "Remove download"; danger: true; clicked => { root.menu-action("Remove download"); } }
                if root.playlist-view: MenuDivider { }
                if root.playlist-view: MenuItem { icon: Icons.up; text: "Move up"; clicked => { root.menu-action("Move up in playlist"); } }
                if root.playlist-view: MenuItem { icon: Icons.down; text: "Move down"; clicked => { root.menu-action("Move down in playlist"); } }
                if root.playlist-view: MenuItem { icon: Icons.trash; text: "Remove from playlist"; danger: true; clicked => { root.menu-action("Remove from playlist"); } }
                if root.playlists.length > 0: MenuDivider { }
                if root.playlists.length > 0: Label {
                    text: "Add to playlist";
                    height: 26px;
                    font-size: 11px;
                    color: Theme.faint;
                    x: 10px;
                }
                for list in root.playlists: MenuItem {
                    icon: Icons.list-plus;
                    text: list.name;
                    clicked => { root.add-playlist(list.id); }
                }
            }
        }
    }
}
