import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Label, Icon, IconButton } from "theme.slint";
import { PlaylistRow } from "sidebar.slint";

export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    source: string,
    liked: bool,
    art: image,
    artists: [string],
}

export component Artwork inherits Rectangle {
    in property <image> source;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: round(root.size * 0.15 / 1px) * 1px;
    background: Theme.raised;
    clip: true;
    if root.source.width == 0: Icon {
        data: Icons.music;
        width: root.size * 0.42;
        height: root.size * 0.42;
        tint: Theme.faint;
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
}

export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-m;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                width: 16px;
                height: 16px;
                tint: root.danger ? #f2555a : touch.has-hover ? Theme.text : Theme.muted;
            }
        }
        Label {
            text: root.text;
            color: root.danger ? #f2555a : Theme.text;
            font-size: 13px;
        }
    }
}

export component MenuDivider inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

/// Text that acts like a link: brighter on hover, pointer cursor, only as wide as its text.
export component LinkText inherits HorizontalLayout {
    in property <string> text;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <color> color: Theme.muted;
    in property <bool> enabled: true;
    in property <bool> grow: true;
    callback clicked;
    label := Label {
        horizontal-stretch: 0;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.enabled && tap.has-hover ? Theme.text : root.color;
        tap := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
    if root.grow: Rectangle { horizontal-stretch: 1; }
}

component TrackItem inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <bool> compact;
    in property <bool> wide: true;
    in property <bool> playing;
    in property <bool> album-view;
    callback play();
    callback like();
    callback menu(length, length);
    callback artist(length, length);
    callback album();
    callback reorder(int);
    callback remove();
    height: root.compact ? 54px : 56px;
    border-radius: Theme.radius-l;
    background: row.has-hover ? Theme.surface : root.playing && root.compact ? Theme.raised : transparent;
    animate background { duration: 100ms; }
    row := TouchArea {
        double-clicked => { root.play(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right && !root.compact {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        HorizontalLayout {
            padding-left: root.compact ? 8px : 10px;
            padding-right: root.compact ? 12px : 10px;
            spacing: root.compact ? 10px : 14px;
            if !root.compact: Rectangle {
                width: 28px;
                if row.has-hover: IconButton {
                    icon: Icons.play;
                    filled: true;
                    size: 28px;
                    icon-size: 14px;
                    tint: Theme.text;
                    clicked => { root.play(); }
                }
                if !row.has-hover && root.playing: Icon {
                    data: Icons.music;
                    width: 15px;
                    height: 15px;
                    tint: Theme.accent;
                }
                if !row.has-hover && !root.playing: Label {
                    text: root.index + 1;
                    color: Theme.faint;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
            if !root.album-view: VerticalLayout {
                alignment: center;
                Artwork { source: root.track.art; size: root.compact ? 38px : 40px; }
            }
            VerticalLayout {
                horizontal-stretch: 3;
                preferred-width: 0px;
                alignment: center;
                spacing: 3px;
                Label {
                    text: root.track.title;
                    font-size: 13.5px;
                    font-weight: 600;
                    color: root.playing ? Theme.accent : Theme.text;
                }
                artist-link := LinkText {
                    text: root.track.artist;
                    clicked => { root.artist(self.absolute-position.x, self.absolute-position.y + self.height + 4px); }
                }
            }
            if !root.compact && root.wide && !root.album-view: VerticalLayout {
                horizontal-stretch: 2;
                preferred-width: 0px;
                alignment: center;
                LinkText {
                    text: root.track.album;
                    font-size: 12.5px;
                    enabled: root.track.album != "";
                    clicked => { root.album(); }
                }
            }
            if !root.compact && root.wide: VerticalLayout {
                width: 84px;
                alignment: center;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.surface;
                        min-width: tag.preferred-width + 16px;
                        tag := Label {
                            text: root.track.source;
                            font-size: 10.5px;
                            font-weight: 500;
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            if !root.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.heart;
                    size: 30px;
                    icon-size: 16px;
                    filled: root.track.liked;
                    tint: root.track.liked ? Theme.accent : Theme.muted;
                    opacity: root.track.liked || row.has-hover ? 1 : 0;
                    clicked => { root.like(); }
                }
            }
            if !root.compact: Label {
                text: root.track.duration;
                width: 44px;
                horizontal-alignment: right;
                color: Theme.muted;
                font-size: 12.5px;
            }
            if !root.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.more;
                    size: 30px;
                    opacity: row.has-hover ? 1 : 0;
                    clicked => { root.menu(self.absolute-position.x - 190px, self.absolute-position.y + 30px); }
                }
            }
            if root.compact && row.has-hover: HorizontalLayout {
                alignment: end;
                VerticalLayout { alignment: center; IconButton { icon: Icons.up; size: 26px; icon-size: 15px; clicked => { root.reorder(-1); } } }
                VerticalLayout { alignment: center; IconButton { icon: Icons.down; size: 26px; icon-size: 15px; clicked => { root.reorder(1); } } }
                VerticalLayout { alignment: center; IconButton { icon: Icons.close; size: 26px; icon-size: 15px; clicked => { root.remove(); } } }
            }
        }
    }
}

/// Lets the user pick one of several credited artists.
export component ArtistChooser inherits PopupWindow {
    in property <[string]> names;
    callback picked(int);
    width: 220px;
    Rectangle {
        background: Theme.popup;
        border-radius: Theme.radius-l;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000090;
        VerticalLayout {
            padding: 4px;
            for name[i] in root.names: MenuItem {
                icon: Icons.artist;
                text: name;
                clicked => { root.picked(i); }
            }
        }
    }
}

export component TrackList inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <[PlaylistRow]> playlists;
    in property <string> now-id;
    in property <int> current: -1;
    in property <bool> compact;
    in property <bool> playlist-view;
    in property <bool> download-view;
    in property <bool> album-view;
    /// Lay the rows out without their own scrolling, for pages that scroll as a whole.
    in property <bool> fixed;
    in property <string> empty-text: "Nothing here yet";
    in property <bool> wide: true;
    callback play(int);
    callback like(int);
    callback open-menu(int);
    callback menu-action(string);
    callback add-playlist(int);
    callback reorder(int, int);
    callback remove(int);
    callback artist(int, int);
    callback album(int);
    private property <length> menu-x;
    private property <length> menu-y;
    private property <int> menu-index: -1;
    private property <int> chooser-index: -1;
    private property <string> chooser-id;
    private property <[string]> chooser-names;
    private property <length> chooser-x;
    private property <length> chooser-y;

    function show-menu(index: int, x: length, y: length) {
        root.menu-index = index;
        root.menu-x = min(x - root.absolute-position.x, root.width - 232px);
        root.menu-y = y - root.absolute-position.y;
        root.open-menu(index);
        menu.show();
    }

    function show-artist(index: int, x: length, y: length) {
        if root.tracks[index].artists.length <= 1 {
            root.artist(index, 0);
            return;
        }
        root.chooser-index = index;
        root.chooser-id = root.tracks[index].id;
        root.chooser-names = root.tracks[index].artists;
        root.chooser-x = min(x - root.absolute-position.x, root.width - 222px);
        root.chooser-y = y - root.absolute-position.y;
        chooser.show();
    }

    if root.tracks.length == 0: VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon { data: Icons.music; width: 28px; height: 28px; tint: Theme.faint; }
        }
        Label {
            text: root.empty-text;
            color: Theme.faint;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if root.tracks.length > 0 && !root.fixed: ListView {
        width: root.width;
        height: root.height;
        for track[index] in root.tracks: TrackItem {
            track: track;
            index: index;
            compact: root.compact;
            wide: root.wide;
            album-view: root.album-view;
            playing: root.compact ? index == root.current : track.id == root.now-id && track.id != "";
            play => { root.play(index); }
            like => { root.like(index); }
            menu(x, y) => { root.show-menu(index, x, y); }
            artist(x, y) => { root.show-artist(index, x, y); }
            album => { root.album(index); }
            reorder(d) => { root.reorder(index, d); }
            remove => { root.remove(index); }
        }
    }
    if root.tracks.length > 0 && root.fixed: VerticalLayout {
        for track[index] in root.tracks: TrackItem {
            track: track;
            index: index;
            wide: root.wide;
            album-view: root.album-view;
            playing: track.id == root.now-id && track.id != "";
            play => { root.play(index); }
            like => { root.like(index); }
            menu(x, y) => { root.show-menu(index, x, y); }
            artist(x, y) => { root.show-artist(index, x, y); }
            album => { root.album(index); }
        }
    }

    chooser := ArtistChooser {
        x: root.chooser-x;
        y: root.chooser-y;
        names: root.chooser-names;
        picked(i) => {
            if root.chooser-index < root.tracks.length && root.tracks[root.chooser-index].id == root.chooser-id {
                root.artist(root.chooser-index, i);
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        Rectangle {
            background: Theme.popup;
            border-radius: Theme.radius-l;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
            VerticalLayout {
                padding: 4px;
                MenuItem { icon: Icons.play; text: "Play"; clicked => { root.menu-action("Play"); } }
                MenuItem { icon: Icons.next-up; text: "Play next"; clicked => { root.menu-action("Play next"); } }
                MenuItem { icon: Icons.queue; text: "Add to queue"; clicked => { root.menu-action("Add to queue"); } }
                MenuItem { icon: Icons.radio; text: "Start radio"; clicked => { root.menu-action("Start radio"); } }
                MenuDivider { }
                MenuItem { icon: Icons.artist; text: "Go to artist"; clicked => { root.show-artist(root.menu-index, root.absolute-position.x + root.menu-x, root.absolute-position.y + root.menu-y); } }
                if !root.album-view && root.menu-index >= 0 && root.menu-index < root.tracks.length && root.tracks[root.menu-index].album != "": MenuItem { icon: Icons.album; text: "Go to album"; clicked => { root.album(root.menu-index); } }
                MenuDivider { }
                MenuItem {
                    icon: Icons.heart;
                    text: root.menu-index >= 0 && root.menu-index < root.tracks.length && root.tracks[root.menu-index].liked ? "Remove from liked" : "Like";
                    clicked => { root.menu-action("Like / Unlike"); }
                }
                if !root.download-view: MenuItem { icon: Icons.download; text: "Download"; clicked => { root.menu-action("Download"); } }
                if root.download-view: MenuItem { icon: Icons.trash; text: "Remove download"; danger: true; clicked => { root.menu-action("Remove download"); } }
                if root.playlist-view: MenuDivider { }
                if root.playlist-view: MenuItem { icon: Icons.up; text: "Move up"; clicked => { root.menu-action("Move up in playlist"); } }
                if root.playlist-view: MenuItem { icon: Icons.down; text: "Move down"; clicked => { root.menu-action("Move down in playlist"); } }
                if root.playlist-view: MenuItem { icon: Icons.trash; text: "Remove from playlist"; danger: true; clicked => { root.menu-action("Remove from playlist"); } }
                if root.playlists.length > 0: MenuDivider { }
                if root.playlists.length > 0: Label {
                    text: "Add to playlist";
                    height: 26px;
                    font-size: 11px;
                    color: Theme.faint;
                    x: 10px;
                }
                for list in root.playlists: MenuItem {
                    icon: Icons.list-plus;
                    text: list.name;
                    clicked => { root.add-playlist(list.id); }
                }
            }
        }
    }
}
