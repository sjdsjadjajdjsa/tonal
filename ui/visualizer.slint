export component Waves inherits Rectangle {
    in property <string> back;
    in property <string> front;
    in property <string> line;
    in property <bool> resting: true;
    in property <color> accent: #ffffff;
    clip: true;
    opacity: root.resting ? 0.5 : 1;
    animate opacity { duration: 700ms; easing: ease-out; }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.back;
        fill: @linear-gradient(180deg, root.accent.with-alpha(0.012) 0%, root.accent.with-alpha(0.07) 100%);
        stroke-width: 0px;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.front;
        fill: @linear-gradient(180deg, root.accent.with-alpha(0.025) 0%, root.accent.with-alpha(0.13) 100%);
        stroke-width: 0px;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.line;
        stroke: root.accent.with-alpha(0.035);
        stroke-width: 9px;
        stroke-line-cap: round;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.line;
        stroke: root.accent.with-alpha(0.07);
        stroke-width: 3.5px;
        stroke-line-cap: round;
    }

    if root.line == "": Rectangle {
        y: root.height - self.height;
        height: min(12px, root.height * 0.2);
        background: @linear-gradient(180deg, root.accent.with-alpha(0) 0%, root.accent.with-alpha(0.06) 100%);
    }
}
